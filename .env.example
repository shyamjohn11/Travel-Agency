# RJ Groups - Environment Variables
# Copy this file to .env and fill in your actual values

# Production domain (without trailing slash)
VITE_APP_DOMAIN=https://rjgroups.in

# Business contact email
VITE_APP_EMAIL=rjgroups2025@gmail.com

# Business phone number
VITE_APP_PHONE=+91 9443679373

# Google Maps API key (only needed if using Google Maps JavaScript API)
# Leave empty if using simple iframe embed
VITE_GOOGLE_MAPS_API_KEY=

# Google Analytics measurement ID (optional)
VITE_GA_MEASUREMENT_ID=

# reCAPTCHA site key (optional, for form spam protection)
VITE_RECAPTCHA_SITE_KEY=

# Admin login (client-side). CHANGE BEFORE DEPLOY, or change inside Admin > Settings.
VITE_ADMIN_EMAIL=admin@rjgroups.in
VITE_ADMIN_PASSWORD=RJ@Admin2026
